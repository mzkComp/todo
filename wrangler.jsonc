{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "todo",
    // Replace with the id returned by: npx wrangler d1 create todo
    "database_id": "20d1b724-51a2-4837-be88-8fe8265871fa",
    "migrations_dir": "cloudflare/migrations"
  }],
  "triggers": { "crons": ["0 */3 * * *"] }
}
